{
  "name": "labdotsa-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Public agent skills and playbooks from labdotsa",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "build": "npm run catalog && npm run build:canonical",
    "build:canonical": "node scripts/build-publication.mjs canonical site",
    "build:e2e": "node scripts/build-publication.mjs canonical .artifacts/e2e",
    "build:matrix": "node scripts/build-publication-matrix.mjs",
    "build:pages": "node scripts/build-publication.mjs pages-project site",
    "build:pages-root": "node scripts/build-publication.mjs pages-root site",
    "build:preview": "node scripts/build-publication.mjs preview site",
    "catalog": "tsx scripts/generate-catalog.ts",
    "dev": "node scripts/run-vite.mjs dev canonical",
    "dev:pages": "node scripts/run-vite.mjs dev pages-project",
    "preview": "node scripts/run-vite.mjs preview canonical",
    "site:build": "npm run build:canonical",
    "site:serve": "npm run preview",
    "test": "tsx --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "node scripts/typecheck.mjs",
    "validate": "bash scripts/validate-skills.sh && tsx scripts/generate-catalog.ts --check && node scripts/validate-source-boundary.mjs && node scripts/validate-dependencies.mjs && npm run typecheck && npm test && npm run build:matrix && npm run test:e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "shadcn-svelte": "1.5.0",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vite": "8.2.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "@lucide/svelte": "1.31.0",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "svelte-sonner": "1.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  }
}
